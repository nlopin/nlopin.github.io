{
  "rules": {
    "answers": {
      ".read": false,
      ".write": false
    },
    "personal": {
      ".read": true,
      ".write": false
    },
    "hints": {
      ".read": "auth != null && now >= 1791410400000",
      ".write": false
    },
    "admins": {
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "students": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'email'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "email": { ".validate": "newData.val() === auth.token.email" },
          "$other": { ".validate": false }
        },
        "tails": {
          "$stamp": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "root.child('personal').child($stamp).val() === true && newData.isString() && newData.val().matches(/^[A-Z0-9]{4}$/) && auth.uid.toUpperCase().contains(newData.val())"
          }
        },
        "solves": {
          "$stamp": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.hasChildren(['code', 'at']) && ((root.child('personal').child($stamp).val() === true && data.parent().parent().child('tails').child($stamp).isString() && newData.child('code').val() === root.child('answers').child($stamp).val() + data.parent().parent().child('tails').child($stamp).val()) || (root.child('personal').child($stamp).val() !== true && newData.child('code').val() === root.child('answers').child($stamp).val()))",
            "code": { ".validate": "newData.isString()" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
